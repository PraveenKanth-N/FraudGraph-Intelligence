# FraudGraph Intelligence (FGI) Configuration
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="FraudGraph Intelligence"
PROJECT_ID="FGI"

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Hardware & Compute Adapter
# local_cuda | colab_runner | cpu_reference
COMPUTE_BACKEND=cpu_reference
CUDA_ARCH=sm_75
ENABLE_GPU_FALLBACK=true

# Data & Storage Paths
DATASET_DIR=D:/FraudGraph Intelligence/data
EXPERIMENTS_DIR=D:/FraudGraph Intelligence/experiments

# Logging
LOG_LEVEL=INFO
